{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/evaluation-methodology/schemas/findings.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "artifact_status", "findings"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "candidate_id": {"$ref": "common.schema.json#/$defs/candidateId"},
    "artifact_status": {"$ref": "common.schema.json#/$defs/artifactStatus"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "source_evidence_id", "risk_id", "title", "severity", "blocking", "status", "owner_actor_id", "remediation"],
        "properties": {
          "finding_id": {"$ref": "common.schema.json#/$defs/identifier"},
          "source_evidence_id": {"$ref": "common.schema.json#/$defs/identifier"},
          "risk_id": {"$ref": "common.schema.json#/$defs/identifier"},
          "title": {"type": "string", "minLength": 5},
          "severity": {"$ref": "common.schema.json#/$defs/riskLevel"},
          "blocking": {"type": "boolean"},
          "status": {"enum": ["open", "remediating", "risk_accepted", "verified_fixed", "false_positive"]},
          "owner_actor_id": {"$ref": "common.schema.json#/$defs/identifier"},
          "remediation": {"type": "string", "minLength": 10},
          "retest_evidence_id": {"$ref": "common.schema.json#/$defs/identifier"},
          "acceptance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["actor_id", "role", "accepted_at", "expires_at", "rationale"],
            "properties": {
              "actor_id": {"$ref": "common.schema.json#/$defs/identifier"},
              "role": {"type": "string", "minLength": 1},
              "accepted_at": {"$ref": "common.schema.json#/$defs/timestamp"},
              "expires_at": {"$ref": "common.schema.json#/$defs/timestamp"},
              "rationale": {"type": "string", "minLength": 10}
            }
          },
          "false_positive_disposition": {
            "type": "object",
            "additionalProperties": false,
            "required": ["actor_id", "role", "decided_at", "rationale", "evidence_ids"],
            "properties": {
              "actor_id": {"$ref": "common.schema.json#/$defs/identifier"},
              "role": {"type": "string", "minLength": 1},
              "decided_at": {"$ref": "common.schema.json#/$defs/timestamp"},
              "rationale": {"type": "string", "minLength": 10},
              "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/identifier"}, "uniqueItems": true}
            }
          }
        },
        "allOf": [
          {"if": {"properties": {"status": {"const": "verified_fixed"}}}, "then": {"required": ["retest_evidence_id"]}},
          {"if": {"properties": {"status": {"const": "risk_accepted"}}}, "then": {"required": ["acceptance"]}},
          {"if": {"properties": {"status": {"const": "false_positive"}}}, "then": {"required": ["false_positive_disposition"]}}
        ]
      }
    }
  }
}
