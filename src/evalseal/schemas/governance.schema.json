{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jonathanjasare/evalseal/main/src/evalseal/schemas/governance.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "version", "status", "organization", "effective_at", "approved_at", "approved_by_actor_id", "next_review_at", "actors", "risk_acceptance_authority", "risk_tolerance", "exception_rules", "evidence_verifier_roles", "resource_limits", "separation_rules"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "policy_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["template", "approved", "retired"]},
    "organization": {"type": "string", "minLength": 2},
    "effective_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "approved_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "approved_by_actor_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "next_review_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor_id", "name", "roles", "active"],
        "properties": {
          "actor_id": {"$ref": "common.schema.json#/$defs/identifier"},
          "name": {"type": "string", "minLength": 2},
          "roles": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"}, "uniqueItems": true},
          "active": {"type": "boolean"}
        }
      }
    },
    "risk_acceptance_authority": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "max_risk_level"],
        "properties": {
          "role": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
          "max_risk_level": {"$ref": "common.schema.json#/$defs/riskLevel"}
        }
      }
    },
    "risk_tolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_accepted_residual_risk", "maximum_conditional_finding_severity"],
      "properties": {
        "maximum_accepted_residual_risk": {"$ref": "common.schema.json#/$defs/riskLevel"},
        "maximum_conditional_finding_severity": {"$ref": "common.schema.json#/$defs/riskLevel"}
      }
    },
    "exception_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_acceptance_days", "maximum_condition_days", "required_conditional_approval_roles", "not_applicable_approval_roles", "false_positive_approval_roles"],
      "properties": {
        "maximum_acceptance_days": {"type": "integer", "minimum": 1, "maximum": 366},
        "maximum_condition_days": {"type": "integer", "minimum": 1, "maximum": 180},
        "required_conditional_approval_roles": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"}, "uniqueItems": true},
        "not_applicable_approval_roles": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"}, "uniqueItems": true},
        "false_positive_approval_roles": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"}, "uniqueItems": true}
      }
    },
    "evidence_verifier_roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "uniqueItems": true
      },
      "propertyNames": {"$ref": "common.schema.json#/$defs/evidenceType"}
    },
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_artifact_bytes"],
      "properties": {
        "maximum_artifact_bytes": {"type": "integer", "minimum": 1024, "maximum": 10737418240}
      }
    },
    "separation_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["roles", "minimum_tier"],
        "properties": {
          "roles": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"}},
          "minimum_tier": {"$ref": "common.schema.json#/$defs/tier"}
        }
      }
    }
  }
}
