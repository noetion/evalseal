{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jonathanjasare/evalseal/main/src/evalseal/schemas/risk-register.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "artifact_status", "risks"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "candidate_id": {"$ref": "common.schema.json#/$defs/candidateId"},
    "artifact_status": {"$ref": "common.schema.json#/$defs/artifactStatus"},
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk_id", "statement", "category", "owner_actor_id", "inherent_risk_level", "treatment", "control_ids", "status", "residual_risk_level", "rationale"],
        "properties": {
          "risk_id": {"$ref": "common.schema.json#/$defs/identifier"},
          "statement": {"type": "string", "minLength": 10, "maxLength": 2000},
          "category": {"enum": ["quality", "safety", "security", "privacy", "fairness", "legal", "operational", "misuse", "financial", "other"]},
          "owner_actor_id": {"$ref": "common.schema.json#/$defs/identifier"},
          "inherent_risk_level": {"$ref": "common.schema.json#/$defs/riskLevel"},
          "treatment": {"enum": ["avoid", "mitigate", "share", "accept", "not_applicable"]},
          "control_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/identifier"}, "uniqueItems": true},
          "status": {"enum": ["open", "treated", "accepted", "not_applicable"]},
          "residual_risk_level": {"$ref": "common.schema.json#/$defs/riskLevel"},
          "rationale": {"type": "string", "minLength": 10},
          "acceptance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["actor_id", "role", "accepted_at", "expires_at", "rationale"],
            "properties": {
              "actor_id": {"$ref": "common.schema.json#/$defs/identifier"},
              "role": {"type": "string", "minLength": 1},
              "accepted_at": {"$ref": "common.schema.json#/$defs/timestamp"},
              "expires_at": {"$ref": "common.schema.json#/$defs/timestamp"},
              "rationale": {"type": "string", "minLength": 10}
            }
          },
          "not_applicable_approval": {
            "type": "object",
            "additionalProperties": false,
            "required": ["actor_id", "role", "decided_at", "rationale"],
            "properties": {
              "actor_id": {"$ref": "common.schema.json#/$defs/identifier"},
              "role": {"type": "string", "minLength": 1},
              "decided_at": {"$ref": "common.schema.json#/$defs/timestamp"},
              "rationale": {"type": "string", "minLength": 10}
            }
          }
        },
        "allOf": [
          {"if": {"properties": {"status": {"enum": ["treated", "accepted"]}}}, "then": {"required": ["acceptance"]}},
          {"if": {"properties": {"status": {"const": "not_applicable"}}}, "then": {"required": ["not_applicable_approval"]}},
          {"if": {"properties": {"status": {"const": "treated"}}}, "then": {"properties": {"control_ids": {"minItems": 1}}}}
        ]
      }
    }
  }
}
