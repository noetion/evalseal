{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jonathanjasare/evalseal/main/src/evalseal/schemas/system-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "artifact_status", "name", "version", "code_revision", "environment", "intended_uses", "prohibited_uses", "jurisdictions", "models", "prompt_bundle_path", "prompt_bundle_sha256", "configuration_path", "configuration_sha256", "retrieval", "tools", "data_classes", "risk_profile", "declared_tier", "applicability", "rollback_target"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "candidate_id": {"$ref": "common.schema.json#/$defs/candidateId"},
    "artifact_status": {"$ref": "common.schema.json#/$defs/artifactStatus"},
    "name": {"type": "string", "minLength": 3, "maxLength": 120},
    "version": {"type": "string", "minLength": 1, "maxLength": 80},
    "code_revision": {"type": "string", "minLength": 7, "maxLength": 128},
    "environment": {"enum": ["staging", "production_candidate", "production"]},
    "intended_uses": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"}},
    "prohibited_uses": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"}},
    "jurisdictions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2, "maxLength": 80}, "uniqueItems": true},
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["purpose", "provider", "model_id", "version", "version_pinned"],
        "properties": {
          "purpose": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "model_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "version_pinned": {"type": "boolean"}
        }
      }
    },
    "prompt_bundle_path": {"$ref": "common.schema.json#/$defs/relativePath"},
    "prompt_bundle_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "configuration_path": {"$ref": "common.schema.json#/$defs/relativePath"},
    "configuration_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "corpus_version", "index_version", "embedding_model"],
      "properties": {
        "enabled": {"type": "boolean"},
        "corpus_version": {"type": ["string", "null"]},
        "index_version": {"type": ["string", "null"]},
        "embedding_model": {"type": ["string", "null"]}
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "permission_scope", "high_impact"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "permission_scope": {"type": "string", "minLength": 1},
          "high_impact": {"type": "boolean"}
        }
      }
    },
    "data_classes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "risk_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["impact", "autonomy", "data_sensitivity", "exposure"],
      "properties": {
        "impact": {"type": "string", "minLength": 1},
        "autonomy": {"type": "string", "minLength": 1},
        "data_sensitivity": {"type": "string", "minLength": 1},
        "exposure": {"type": "string", "minLength": 1}
      }
    },
    "declared_tier": {"$ref": "common.schema.json#/$defs/tier"},
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uses_personal_data", "affects_rights_or_access", "uses_model_grader", "has_external_actions", "has_accessibility_impact", "regulated_use"],
      "properties": {
        "uses_personal_data": {"type": "boolean"},
        "affects_rights_or_access": {"type": "boolean"},
        "uses_model_grader": {"type": "boolean"},
        "has_external_actions": {"type": "boolean"},
        "has_accessibility_impact": {"type": "boolean"},
        "regulated_use": {"type": "boolean"}
      }
    },
    "rollback_target": {"type": "string", "minLength": 1, "maxLength": 160}
  },
  "allOf": [
    {
      "if": {"properties": {"retrieval": {"properties": {"enabled": {"const": true}}}}},
      "then": {"properties": {"retrieval": {"properties": {
        "corpus_version": {"type": "string", "minLength": 1},
        "index_version": {"type": "string", "minLength": 1},
        "embedding_model": {"type": "string", "minLength": 1}
      }}}},
      "else": {"properties": {"retrieval": {"properties": {
        "corpus_version": {"type": "null"},
        "index_version": {"type": "null"},
        "embedding_model": {"type": "null"}
      }}}}
    }
  ]
}
