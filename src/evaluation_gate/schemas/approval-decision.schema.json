{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/evaluation-methodology/schemas/approval-decision.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "artifact_status", "decision", "decided_at", "approvers", "input_hashes", "evidence_ids", "residual_risk_ids", "conditions", "rollback_target", "next_review_at"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "candidate_id": {"$ref": "common.schema.json#/$defs/candidateId"},
    "artifact_status": {"$ref": "common.schema.json#/$defs/artifactStatus"},
    "decision": {"enum": ["approve", "approve_with_conditions", "reject"]},
    "decided_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "approvers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor_id", "role", "approved_at"],
        "properties": {
          "actor_id": {"$ref": "common.schema.json#/$defs/identifier"},
          "role": {"type": "string", "minLength": 1},
          "approved_at": {"$ref": "common.schema.json#/$defs/timestamp"}
        }
      }
    },
    "input_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack", "system_manifest", "risk_register", "controls", "evaluation_cases", "evidence_index", "findings", "change_assessment"],
      "properties": {
        "pack": {"$ref": "common.schema.json#/$defs/sha256"},
        "system_manifest": {"$ref": "common.schema.json#/$defs/sha256"},
        "risk_register": {"$ref": "common.schema.json#/$defs/sha256"},
        "controls": {"$ref": "common.schema.json#/$defs/sha256"},
        "evaluation_cases": {"$ref": "common.schema.json#/$defs/sha256"},
        "evidence_index": {"$ref": "common.schema.json#/$defs/sha256"},
        "findings": {"$ref": "common.schema.json#/$defs/sha256"},
        "change_assessment": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "evidence_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/identifier"}, "uniqueItems": true},
    "residual_risk_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/identifier"}, "uniqueItems": true},
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition_id", "description", "owner_actor_id", "finding_ids", "due_at", "status"],
        "properties": {
          "condition_id": {"$ref": "common.schema.json#/$defs/identifier"},
          "description": {"type": "string", "minLength": 10},
          "owner_actor_id": {"$ref": "common.schema.json#/$defs/identifier"},
          "finding_ids": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/identifier"}, "uniqueItems": true},
          "due_at": {"$ref": "common.schema.json#/$defs/timestamp"},
          "status": {"enum": ["open", "closed"]}
        }
      }
    },
    "rollback_target": {"type": "string", "minLength": 1},
    "next_review_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  },
  "allOf": [
    {"if": {"properties": {"decision": {"const": "approve_with_conditions"}}}, "then": {"properties": {"conditions": {"minItems": 1}}}}
  ]
}
