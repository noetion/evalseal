{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/evaluation-methodology/schemas/evaluation-cases.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "artifact_status", "evaluation_set_id", "version", "dataset_path", "dataset_sha256", "cases"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "candidate_id": {"$ref": "common.schema.json#/$defs/candidateId"},
    "artifact_status": {"$ref": "common.schema.json#/$defs/artifactStatus"},
    "evaluation_set_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "version": {"type": "string", "minLength": 1},
    "dataset_path": {"$ref": "common.schema.json#/$defs/relativePath"},
    "dataset_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "requirement_ids", "risk_ids", "category", "severity", "oracle", "acceptance_rule", "repetitions", "status"],
        "properties": {
          "case_id": {"$ref": "common.schema.json#/$defs/identifier"},
          "requirement_ids": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/identifier"}, "uniqueItems": true},
          "risk_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/identifier"}, "uniqueItems": true},
          "category": {"enum": ["representative", "boundary", "adversarial", "regression", "must_abstain", "must_answer", "fairness", "operational"]},
          "severity": {"$ref": "common.schema.json#/$defs/riskLevel"},
          "oracle": {"type": "string", "minLength": 3},
          "acceptance_rule": {"type": "string", "minLength": 10},
          "repetitions": {"type": "integer", "minimum": 1, "maximum": 10000},
          "status": {"enum": ["active", "retired"]}
        }
      }
    }
  }
}
